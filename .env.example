# ── Database ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=threadly_dev

# ── Redis ─────────────────────────────────────────────────────────
REDIS_PASSWORD=threadly_dev

# ── JWT (keys generated by bootstrap.sh) ─────────────────────────
JWT_PRIVATE_KEY_PATH=./infra/keys/private.pem
JWT_PUBLIC_KEY_PATH=./infra/keys/public.pem

# ── Centrifugo ────────────────────────────────────────────────────
CENTRIFUGO_HTTP_API_KEY=dev_api_key
CENTRIFUGO_TOKEN_HMAC_SECRET=dev_secret_change_in_prod
CENTRIFUGO_ADMIN_PASSWORD=dev_admin
CENTRIFUGO_ADMIN_SECRET=dev_admin_secret

# ── AI providers (set ANTHROPIC_API_KEY at minimum) ───────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
VOYAGE_API_KEY=

# ── Internal service auth ─────────────────────────────────────────
CORE_AI_SHARED_SECRET=dev_shared_secret

# ── Object storage (MinIO locally) ───────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=threadly-kb
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Next.js / Auth.js ────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev_nextauth_secret_change_in_prod

# ── Langfuse (optional) ──────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3003
