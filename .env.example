# ═══════════════════════════════════════════════════════════
# Threadly — Environment Variables
# Copy to .env and fill in your values before running.
# Never commit .env to git.
# ═══════════════════════════════════════════════════════════

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_PASSWORD=threadly_dev          # Change in production

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=threadly_dev             # Change in production

# ── Centrifugo ───────────────────────────────────────────────
CENTRIFUGO_TOKEN_HMAC_SECRET=dev_secret_change_in_prod   # CHANGE THIS in prod — signs visitor JWTs
CENTRIFUGO_HTTP_API_KEY=dev_api_key                      # CHANGE THIS in prod — used by core to publish
CENTRIFUGO_ADMIN_PASSWORD=admin                          # Centrifugo admin UI password
CENTRIFUGO_ADMIN_SECRET=admin_secret                     # Centrifugo admin API secret

# ── S3 / MinIO ───────────────────────────────────────────────
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=threadly-kb
# For production, point to Cloudflare R2 or AWS S3:
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=<r2-access-key>
# S3_SECRET_KEY=<r2-secret-key>

# ── Service-to-service auth ───────────────────────────────────
CORE_AI_SHARED_SECRET=dev_shared_secret     # CHANGE THIS — Core→AI HMAC signing key

# ── AI Providers ─────────────────────────────────────────────
ANTHROPIC_API_KEY=                  # Required — get from console.anthropic.com
OPENAI_API_KEY=                     # Optional — fallback provider
VOYAGE_API_KEY=                     # Optional — better embeddings (voyage-3-lite)
COHERE_API_KEY=                     # Optional — reranking (rerank-english-v3.0)

# ── LLM Observability ─────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=                # Optional — get from langfuse.com
LANGFUSE_SECRET_KEY=                # Optional
LANGFUSE_HOST=http://langfuse:3000  # Self-hosted default; use https://cloud.langfuse.com for cloud

# ── Security ─────────────────────────────────────────────────
# 32+ character random string for AES-256-GCM credential encryption
CREDENTIAL_MASTER_KEY=dev_master_key_32_chars_padding__  # CHANGE THIS in prod
# Generate: openssl rand -base64 32

# ── JWT ───────────────────────────────────────────────────────
JWT_EXPIRY_SECONDS=900              # Access token lifetime (15 min)
JWT_REFRESH_EXPIRY_DAYS=30         # Refresh token lifetime

# ── Next.js ───────────────────────────────────────────────────
NEXTAUTH_SECRET=dev_nextauth_secret  # CHANGE THIS — run: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000   # Set to your public URL in production

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_AUTH_RPM=10              # Auth endpoint requests per minute per IP
RATE_LIMIT_API_RPM=1000             # API requests per minute per org
