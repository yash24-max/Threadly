# Multi-stage Dockerfile for Threadly Java Microservices
# Builds any of the 9 Spring Boot services via SERVICE_NAME build arg
# Services: identity, workspace, flow, runtime, conversation, knowledge, analytics, billing, integration
#
# Usage: docker build -t threadly/identity-service --build-arg SERVICE_NAME=identity-service -f Dockerfile.core .

# Stage 1: Builder
FROM eclipse-temurin:21-jdk-alpine AS builder

ARG SERVICE_NAME=identity-service
ARG MAVEN_VERSION=3.9.6

WORKDIR /build

# Install Maven
RUN apk add --no-cache maven curl

# Copy parent POM and common module first (for dependency caching)
COPY services/threadly-common-spring/pom.xml ./services/threadly-common-spring/pom.xml
COPY services/threadly-common-spring/src ./services/threadly-common-spring/src

# Copy root POM
COPY pom.xml ./pom.xml

# Copy the specific service module
COPY services/${SERVICE_NAME}/pom.xml ./services/${SERVICE_NAME}/pom.xml
COPY services/${SERVICE_NAME}/src ./services/${SERVICE_NAME}/src

# Build only the specific service + common dependencies
RUN mvn clean package \
    -pl "services/threadly-common-spring,services/${SERVICE_NAME}" \
    -am \
    -DskipTests \
    -B \
    -q \
    -Dorg.slf4j.simpleLogger.defaultLogLevel=warn

# Extract the JAR for slim packaging
RUN cd services/${SERVICE_NAME}/target && \
    JAR_FILE=$(ls *.jar | head -1) && \
    java -Djarmode=layertools -jar "$JAR_FILE" extract && \
    ls -la

# Stage 2: Runtime
FROM eclipse-temurin:21-jre-alpine

ARG SERVICE_NAME=identity-service

WORKDIR /app

# Create non-root user for security
RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

# Copy application layers from builder
COPY --from=builder --chown=appuser:appuser /build/services/${SERVICE_NAME}/target/dependencies/ ./
COPY --from=builder --chown=appuser:appuser /build/services/${SERVICE_NAME}/target/spring-boot-loader/ ./
COPY --from=builder --chown=appuser:appuser /build/services/${SERVICE_NAME}/target/snapshot-dependencies/ ./
COPY --from=builder --chown=appuser:appuser /build/services/${SERVICE_NAME}/target/application/ ./

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://localhost:8080/actuator/health || exit 1

USER appuser

EXPOSE 8080

# Use exec form to ensure signals are properly handled
ENTRYPOINT ["java", "org.springframework.boot.loader.launch.JarLauncher"]
