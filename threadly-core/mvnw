# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
# ----------------------------------------------------------------------------

# If JAVA_HOME is set, use it; otherwise use java from PATH
if [ -n "$JAVA_HOME" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD="java"
fi

# Determine the script directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Maven wrapper properties
WRAPPER_PROPERTIES="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.properties"
WRAPPER_JAR="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.jar"

# Read distributionUrl from properties
DISTRIBUTION_URL=$(grep "distributionUrl" "$WRAPPER_PROPERTIES" | cut -d'=' -f2)
WRAPPER_URL=$(grep "wrapperUrl" "$WRAPPER_PROPERTIES" | cut -d'=' -f2-)

# Maven home: ~/.m2/wrapper/dists/<distribution>
DISTRIBUTION_NAME=$(basename "$DISTRIBUTION_URL" .zip)
MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"
MAVEN_HOME="$MAVEN_USER_HOME/wrapper/dists/$DISTRIBUTION_NAME"

# Download and install Maven if not present
if [ ! -d "$MAVEN_HOME" ]; then
  mkdir -p "$MAVEN_HOME"
  TMP_FILE="$MAVEN_HOME/$DISTRIBUTION_NAME.zip"
  echo "Downloading Apache Maven from $DISTRIBUTION_URL..."
  if command -v curl > /dev/null 2>&1; then
    curl -fsSL -o "$TMP_FILE" "$DISTRIBUTION_URL"
  elif command -v wget > /dev/null 2>&1; then
    wget -q -O "$TMP_FILE" "$DISTRIBUTION_URL"
  else
    echo "ERROR: Neither curl nor wget is available. Cannot download Maven."
    exit 1
  fi
  unzip -q "$TMP_FILE" -d "$MAVEN_HOME"
  rm -f "$TMP_FILE"
fi

# Find the mvn executable inside the distribution
MVN_EXEC=$(find "$MAVEN_HOME" -name "mvn" -type f | head -1)
if [ -z "$MVN_EXEC" ]; then
  echo "ERROR: Could not find mvn executable in $MAVEN_HOME"
  exit 1
fi

exec "$MVN_EXEC" "$@"
