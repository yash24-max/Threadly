{
  "token_hmac_secret_key": "${CENTRIFUGO_TOKEN_HMAC_SECRET}",
  "api_key": "${CENTRIFUGO_HTTP_API_KEY}",
  "admin": true,
  "admin_password": "${CENTRIFUGO_ADMIN_PASSWORD}",
  "admin_secret": "${CENTRIFUGO_ADMIN_SECRET}",
  "log_level": "info",
  "log_format": "json",
  "health": true,
  "port": 8000,

  "client_anonymous": false,
  "history_size": 100,
  "history_ttl": "300s",
  "presence": true,
  "join_leave": true,
  "force_recovery": true,

  "engine": "redis",
  "redis": {
    "address": "redis:6379"
  },

  "namespaces": [
    {
      "name": "chat",
      "presence": true,
      "join_leave": false,
      "history_size": 200,
      "history_ttl": "600s",
      "force_recovery": true,
      "proxy_subscribe": true,
      "proxy_publish": true
    },
    {
      "name": "dashboard",
      "presence": false,
      "history_size": 10,
      "history_ttl": "60s"
    },
    {
      "name": "agent",
      "presence": true,
      "join_leave": true,
      "history_size": 50,
      "history_ttl": "300s"
    }
  ],

  "proxy_connect_endpoint": "http://threadly-core:8080/v1/proxy/connect",
  "proxy_subscribe_endpoint": "http://threadly-core:8080/v1/proxy/subscribe",
  "proxy_publish_endpoint": "http://threadly-core:8080/v1/proxy/publish",
  "proxy_rpc_endpoint": "http://threadly-core:8080/v1/proxy/rpc",

  "cors_allowed_origins": ["*"],

  "websocket_compression": true,
  "websocket_use_write_buffer_pool": true
}
